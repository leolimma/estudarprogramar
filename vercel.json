{
  "functions": {
    "api.php": {
      "runtime": "vercel-php@0.6.0"
    },
    "api/*.php": {
      "runtime": "vercel-php@0.6.0"
    }
  },
  "routes": [
    {
      "src": "/api",
      "dest": "/api.php"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api.php"
    },
    {
      "src": "/api.php(.*)",
      "dest": "/api.php"
    },
    {
      "handle": "filesystem"
    }
  ]
}
