# =========================================================================
# CONFIGURAÇÃO DE AMBIENTE - CYBER RUNNER
# =========================================================================

# URL do seu projeto no Supabase (exemplo: https://xyzcompany.supabase.co)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública anônima do Supabase (Anon Public API Key)
SUPABASE_ANON_KEY=sua-anon-key-aqui

# Modo de Armazenamento:
# - hybrid: Grava no SQLite local (offline) e sincroniza na nuvem (Supabase) quando online. (Recomendado)
# - sqlite: Utiliza apenas o banco de dados SQLite local (100% offline).
# - supabase: Utiliza prioritariamente o Supabase Cloud.
STORAGE_MODE=hybrid
